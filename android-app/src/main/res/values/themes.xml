<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GeniusIPTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/genius_blue</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/dark_gray</item>
        <item name="colorBackground">@color/black</item>
        <item name="colorSurface">@color/dark_gray</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/light_gray</item>
    </style>

    <style name="Theme.GeniusIPTV.NoActionBar" parent="Theme.GeniusIPTV">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>